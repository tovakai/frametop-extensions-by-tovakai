{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "description": "Spatial Room manual room placement: capture only while standalone editor is open",
  "name": "Spatial Room",
  "bindings": {
    "/actions/room": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/room/in/place"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/room/in/mode"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/room/in/confirm"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/room/in/undo"
            }
          }
        },
        {
          "path": "/user/hand/right/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/room/in/label"
            }
          }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/room/in/height"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/room/in/rotate"
            }
          }
        },
        {
          "path": "/user/hand/right/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/room/in/save"
            }
          }
        }
      ]
    }
  }
}
